# Upstash Redis / Vercel KV credentials for unique visitor tracking
# (Leave empty to use local file fallback in development)

# Option A: Upstash Redis (from console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Option B: Vercel KV (automatically set if created in Vercel Storage)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
